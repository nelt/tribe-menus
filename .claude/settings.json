{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go run:*)",
      "Bash(go tool:*)",
      "Bash(go mod tidy)",
      "Bash(go version)",
      "Bash(gofmt:*)",
      "Bash(npm run:*)",
      "Bash(npm ci:*)",
      "Bash(npx playwright test:*)",
      "Bash(node --test:*)",
      "Bash(sqlite3:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git push)",
      "Bash(git push origin feature/*)",
      "Bash(git push -u origin feature/*)",
      "Bash(gh auth status)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run download:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh api repos/nelt/tribe-menus/actions/*)"
    ],
    "deny": [
      "Bash(git push *--force*)",
      "Bash(git push * -f*)",
      "Bash(git push *--delete*)",
      "Bash(git push *main*)",
      "Bash(gh pr merge:*)",
      "Bash(gh auth token:*)",
      "Read(~/.config/gh/**)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
