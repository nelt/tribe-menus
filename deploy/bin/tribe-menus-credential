#!/usr/bin/env bash
# Reads a secret at the keyboard, without echo, and writes it encrypted with the key of the
# machine (systemd-creds), where the service or the server reads it (ADR 0015, point 10;
# plan recette, D5). The secret is never in a command line, the environment or a file in
# clear. Installed by provision.sh.
#
#   sudo tribe-menus-credential production|recette smtp-password
#   sudo tribe-menus-credential server smtp-password|github-token
set -euo pipefail

die() {
	printf 'tribe-menus-credential: %s\n' "$*" >&2
	exit 1
}

usage() {
	cat >&2 <<'EOF'
Usage: tribe-menus-credential production|recette smtp-password
       tribe-menus-credential server smtp-password|github-token
EOF
	exit 2
}

(($# == 2)) || usage
case "$1 $2" in
"production smtp-password" | "recette smtp-password")
	dir=/etc/tribe-menus/$1 name=smtp-password label="SMTP password of the application ($1)"
	;;
"server smtp-password")
	dir=/etc/tribe-menus/server name=server-smtp-password label="SMTP password of the server"
	;;
"server github-token")
	dir=/etc/tribe-menus/server name=github-token label="GitHub token of the server"
	;;
*) usage ;;
esac
dest=$dir/${2}.cred

[[ $(id -u) == 0 ]] || die "run as root: sudo tribe-menus-credential $*"
[[ -d $dir ]] || die "$dir missing: run provision.sh first"
[[ -t 0 ]] || die "run from a terminal: the secret is read at the keyboard"

IFS= read -r -s -p "$label: " secret
printf '\n'
IFS= read -r -s -p "Again: " again
printf '\n'
[[ -n $secret ]] || die "empty secret, nothing written"
[[ $secret == "$again" ]] || die "the two entries differ, nothing written"
unset again

umask 077
tmp=$(mktemp -- "$dest.XXXXXX")
trap 'rm -f -- "$tmp"' EXIT
# printf is a builtin: the secret reaches systemd-creds by a pipe, not by its arguments.
printf '%s' "$secret" | systemd-creds encrypt --with-key=host --name="$name" - "$tmp"
[[ $(systemd-creds decrypt --name="$name" "$tmp" -) == "$secret" ]] || die "decryption check failed, nothing written"
unset secret
mv -f -- "$tmp" "$dest"
trap - EXIT
printf 'Written: %s\n' "$dest"

# The service reads its credential at start; on hold, at the end of the hold.
if [[ $1 != server ]]; then
	if [[ $(systemctl is-enabled "tribe-menus@$1.socket" 2>/dev/null || true) == masked ]]; then
		printf '%s is on hold: the credential is read at the end of the hold\n' "$1"
	else
		systemctl try-restart "tribe-menus@$1.service"
		systemctl start "tribe-menus@$1.socket"
	fi
fi
