// Dev Container de référence (ADR 0009, 0018, 0020).
// Toute extension ajoutée ou mise à jour passe par une PR qui modifie ce fichier.
{
  "name": "tribe-menus",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,

  // Claude Code et GitHub CLI : configuration et connexion conservées dans
  // des volumes. Mises à jour automatiques, télémétrie, rapports d'erreur et
  // commande /feedback désactivés un par un : la variable globale
  // CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC couperait aussi Remote Control
  // (ADR 0020).
  // Git pousse avec le jeton de gh (ADR 0020) : les deux réglages
  // credential.helper passés par l'environnement s'appliquent après ceux de
  // .git/config, écrits pour l'hôte (trousseau absent du conteneur).
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "GH_TELEMETRY": "0",
    "GH_NO_UPDATE_NOTIFIER": "1",
    "GIT_CONFIG_COUNT": "2",
    "GIT_CONFIG_KEY_0": "credential.helper",
    "GIT_CONFIG_VALUE_0": "",
    "GIT_CONFIG_KEY_1": "credential.helper",
    "GIT_CONFIG_VALUE_1": "!gh auth git-credential"
  },
  "mounts": [
    "source=tribe-menus-claude,target=/home/vscode/.claude,type=volume",
    "source=tribe-menus-gh,target=/home/vscode/.config/gh,type=volume"
  ],

  // Pas d'agent SSH de l'hôte dans le conteneur : le push passe par HTTPS,
  // avec le jeton du conteneur (ADR 0020).
  "remoteEnv": {
    "SSH_AUTH_SOCK": ""
  },

  // Installation des dépendances et des navigateurs Playwright (ADR 0009).
  "postCreateCommand": "make tools",

  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "tribe-menus (make dev)" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go@0.56.1",
        "ms-playwright.playwright@1.1.19",
        "anthropic.claude-code@2.1.284"
      ],
      "settings": {
        "extensions.autoUpdate": false,
        "extensions.autoCheckUpdates": false,
        "telemetry.telemetryLevel": "off",
        "go.toolsManagement.autoUpdate": false,
        "go.toolsManagement.checkForUpdates": "off"
      }
    }
  }
}
